// This is the Prisma schema for WorkshopHub
// Run `pnpm exec prisma db push` to apply changes
// Run `pnpm exec prisma db seed` to populate with sample data

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TrainingSession {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  date         DateTime
  capacity     Int
  registered   Int      @default(0)
  location     String
  deliveryMode String
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  registrations Registration[]

  @@map("training_sessions")
}

model Registration {
  id                Int      @id @default(autoincrement())
  name              String
  email             String
  status            String
  trainingSessionId Int
  createdAt         DateTime @default(now())

  trainingSession TrainingSession @relation(fields: [trainingSessionId], references: [id])
  auditLogs       AuditLog[]

  @@index([trainingSessionId, status, createdAt])
  @@map("registrations")
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  registrationId Int
  fromStatus     String?
  toStatus       String
  changedAt      DateTime @default(now())
  reason         String?

  registration Registration @relation(fields: [registrationId], references: [id])

  @@index([registrationId, changedAt])
  @@map("audit_logs")
}
