# Copy this file to .env for local development
# Never commit .env to git

# Database — path is relative to api/prisma/schema.prisma location, resolves to api/database/workshophub.sqlite
DATABASE_URL="file:../database/workshophub.sqlite"

# API server port
APP_PORT=3001

# Node environment
NODE_ENV=development

# Frontend API URL (used by Vite)
VITE_API_URL=http://localhost:3001
