# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
app/dist/
api/dist/

# Environment files — never commit these
.env
.env.local
.env.production
.env.*.local

# Database files — SQLite path is relative to prisma/schema.prisma, resolves to api/database/
api/database/*.sqlite
api/database/*.sqlite-journal
api/database/*.sqlite-wal
api/database/*.sqlite-shm
# Also cover root-level database/ dir just in case
database/*.sqlite
database/*.sqlite-journal
database/*.sqlite-wal
database/*.sqlite-shm

# Prisma generated client
api/generated/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Test coverage
coverage/

# Temp
tmp/
temp/
